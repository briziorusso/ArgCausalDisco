{
  "release": "paper_aaai2027",
  "sample_size": 5000,
  "seeds": {
    "start": 2026,
    "end": 2075,
    "count": 50
  },
  "datasets": {
    "fixed": ["cancer", "earthquake", "survey", "asia"],
    "synthetic_primary": ["er5", "er8", "sf5", "sf8"],
    "primary_edges_per_node": 1,
    "sensitivity_edges_per_node": 2
  },
  "shared_ci": {
    "methods": ["ABA-PC", "OptABA-PC", "MPC"],
    "test": "gsq",
    "alpha": 0.01
  },
  "repair": {
    "conditioning_set_weight": false,
    "encoding": "incremental_bayes_ball",
    "opt_strategy": "bb",
    "opt_mode": "optN",
    "objective": "minimum_total_release_weight",
    "reification": "mus",
    "threads": 4,
    "solve_timeout_seconds": 300,
    "graph_evaluation_timeout_seconds": 120
  },
  "mpc": {
    "stable": true,
    "uc_rule": 5,
    "uc_priority": 2,
    "conditioning_depth_limit": null
  },
  "fgs": {
    "score": "sem-bic",
    "maximum_degree": -1,
    "faithfulness_assumed": true
  },
  "aspcr_dag": {
    "datasets_reported": ["cancer", "earthquake", "survey"],
    "test": "bayes",
    "weight": "log",
    "prior_independence": 0.4,
    "bayesian_alpha": 20,
    "conditioning_schedule": "n-2",
    "model_space": "dag_sufficient",
    "encoding": "new_wmaxsat_acyclic_sufficient.pl",
    "solver_configuration": "crafty",
    "solver_timeout_seconds": 25000
  },
  "versions": {
    "baseline_fixed": "paper_bnlearn_alpha001_nowrong_noweight_50rep_mpc_fgs",
    "baseline_synthetic_primary": "paper_er_sf_sparse_alpha001_noweight_50rep_mpc_fgs",
    "baseline_synthetic_dense_mpc": "paper_er_sf_alpha001_nowrong_noweight_50rep_mpc",
    "baseline_synthetic_dense_fgs": "paper_er_sf_alpha001_nowrong_noweight_50rep_fgs",
    "aspcr": "paper_aspcr_dag_alpha001_n5000_50rep",
    "tables": "paper_final_matched_50rep"
  },
  "excluded": [
    "injected_fact_corruption",
    "shapley_pc",
    "smoke_runs",
    "ten_repetition_runs",
    "development_alpha_0.05"
  ]
}
