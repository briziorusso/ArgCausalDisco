<PROPERTY>software aGrUM</PROPERTY>

<!-- Variables -->
<VARIABLE TYPE="nature">
	<NAME>osteoporosis</NAME>
	<PROPERTY>description = A skeletal disorder characterized by reduced bone mineral density and deterioration of bone tissue, leading to increased bone fragility.</PROPERTY>
	<PROPERTY>fast = osteoporosis[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>degeneration</NAME>
	<PROPERTY>description = The progressive deterioration of tissues, organs, or functions over time, often associated with aging, disease processes, or wear and tear.</PROPERTY>
	<PROPERTY>fast = degeneration[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>high_blood_pressure</NAME>
	<PROPERTY>description = A common physiological condition where arterial blood pressure is persistently elevated above normal levels.</PROPERTY>
	<PROPERTY>fast = high_blood_pressure[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>blindness</NAME>
	<PROPERTY>description = The complete or significant loss of vision, rendering an individual unable to perceive light, forms, or movements.</PROPERTY>
	<PROPERTY>fast = blindness[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>eye_problems</NAME>
	<PROPERTY>description = A broad category encompassing various conditions or disorders affecting the eyes, potentially leading to visual impairment, discomfort, or structural changes.</PROPERTY>
	<PROPERTY>fast = eye_problems[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>numbness</NAME>
	<PROPERTY>description = A sensory alteration characterized by a partial or complete loss of feeling or sensation in a particular area of the body.</PROPERTY>
	<PROPERTY>fast = numbness[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>brain_damage</NAME>
	<PROPERTY>description = Any injury or damage to the brain, which may result in impaired cognitive, sensory, or physical functions.</PROPERTY>
	<PROPERTY>fast = brain_damage[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>neck_pain</NAME>
	<PROPERTY>description = Discomfort, aching, or stiffness sensations localized to the cervical region of the spine, varying in intensity and duration.</PROPERTY>
	<PROPERTY>fast = neck_pain[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>spinal_stenosis</NAME>
	<PROPERTY>description = A medical condition involving the narrowing of the spaces within the spine, which can put pressure on the spinal cord and nerves.</PROPERTY>
	<PROPERTY>fast = spinal_stenosis[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>birth_defect</NAME>
	<PROPERTY>description = A congenital abnormality or impairment present from birth, affecting bodily structure or function.</PROPERTY>
	<PROPERTY>fast = birth_defect[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

