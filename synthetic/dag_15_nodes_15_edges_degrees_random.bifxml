<?xml version="1.0" ?>

<BIF VERSION="0.3">
<NETWORK>
<NAME>dag_15_nodes_15_edges_degrees_random</NAME>
<PROPERTY>software aGrUM</PROPERTY>

<!-- Variables -->
<VARIABLE TYPE="nature">
	<NAME>lack_of_sleep</NAME>
	<PROPERTY>description = A state of insufficient sleep duration, meaning an individual consistently does not obtain the recommended number of hours of sleep.</PROPERTY>
	<PROPERTY>fast = lack_of_sleep[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>behavioral_problems</NAME>
	<PROPERTY>description = Maladaptive or disruptive patterns of conduct and actions that deviate from expected social norms or cause distress.</PROPERTY>
	<PROPERTY>fast = behavioral_problems[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>chronic_pain</NAME>
	<PROPERTY>description = Persistent or recurrent pain that lasts for an extended period, typically beyond three to six months, despite treatment or normal healing processes.</PROPERTY>
	<PROPERTY>fast = chronic_pain[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>despair</NAME>
	<PROPERTY>description = A profound state of hopelessness, an extreme loss of hope or confidence in one's future or circumstances.</PROPERTY>
	<PROPERTY>fast = despair[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>social_problems</NAME>
	<PROPERTY>description = Difficulties or challenges that individuals encounter in their interactions with others or in their integration into community structures and societal norms.</PROPERTY>
	<PROPERTY>fast = social_problems[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>poor_sleep</NAME>
	<PROPERTY>description = A condition characterized by inadequate quality or restorative capacity of sleep, irrespective of the duration.</PROPERTY>
	<PROPERTY>fast = poor_sleep[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>alcohol_abuse</NAME>
	<PROPERTY>description = The harmful consumption of alcoholic beverages, leading to negative health, social, or occupational outcomes.</PROPERTY>
	<PROPERTY>fast = alcohol_abuse[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
