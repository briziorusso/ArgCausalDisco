	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>burnout</NAME>
	<PROPERTY>description = A state of emotional, physical, and mental exhaustion caused by prolonged or excessive stress, often characterized by feelings of being overwhelmed, depleted, and lacking motivation.</PROPERTY>
	<PROPERTY>fast = burnout[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
