	<PROPERTY>fast = responsibilities[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>lack_of_appropriate_supervision</NAME>
	<PROPERTY>description = The absence or inadequacy of oversight and guidance provided to an individual, particularly during formative or vulnerable periods.</PROPERTY>
	<PROPERTY>fast = lack_of_appropriate_supervision[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>abandoned_child_syndrome</NAME>
	<PROPERTY>description = A complex set of psychological and emotional difficulties stemming from perceived or actual emotional or physical abandonment during childhood.</PROPERTY>
	<PROPERTY>fast = abandoned_child_syndrome[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

