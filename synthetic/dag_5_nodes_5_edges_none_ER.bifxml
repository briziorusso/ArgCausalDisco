<?xml version="1.0" ?>

<BIF VERSION="0.3">
<NETWORK>
<NAME>dag_5_nodes_5_edges_none_ER</NAME>
<PROPERTY>software aGrUM</PROPERTY>

<!-- Variables -->
<VARIABLE TYPE="nature">
	<NAME>vomiting</NAME>
	<PROPERTY>description = The involuntary forceful expulsion of stomach contents through the mouth, often accompanied by feelings of nausea.</PROPERTY>
	<PROPERTY>fast = vomiting[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>low_potassium_levels</NAME>
	<PROPERTY>description = A medical condition indicating an abnormally reduced concentration of potassium, a vital electrolyte, in the bloodstream.</PROPERTY>
	<PROPERTY>fast = low_potassium_levels[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>severe_dehydration</NAME>
	<PROPERTY>description = A critical medical state where the body's fluid content is significantly reduced, impairing normal physiological functions.</PROPERTY>
	<PROPERTY>fast = severe_dehydration[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>diarrhoea</NAME>
	<PROPERTY>description = A common gastrointestinal symptom characterized by frequent, loose, or watery bowel movements.</PROPERTY>
	<PROPERTY>fast = diarrhoea[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>kidney_failure</NAME>
	<PROPERTY>description = A severe medical condition where the kidneys lose their ability to adequately filter waste products and regulate fluid balance in the body.</PROPERTY>
	<PROPERTY>fast = kidney_failure[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

