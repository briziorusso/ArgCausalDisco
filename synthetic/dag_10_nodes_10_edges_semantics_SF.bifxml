<PROPERTY>software aGrUM</PROPERTY>

<!-- Variables -->
<VARIABLE TYPE="nature">
	<NAME>surgery</NAME>
	<PROPERTY>description = A medical procedure involving manual or instrumental intervention on the body to treat diseases, injuries, or deformities, requiring a controlled invasive technique.</PROPERTY>
	<PROPERTY>fast = surgery[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>brain_damage</NAME>
	<PROPERTY>description = Any injury or destruction to brain cells that impairs its normal functioning, potentially affecting cognitive, physical, or emotional abilities.</PROPERTY>
	<PROPERTY>fast = brain_damage[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>alcoholism</NAME>
	<PROPERTY>description = A chronic and progressive disease characterized by an impaired ability to control alcohol use despite adverse consequences to health, social life, or work.</PROPERTY>
	<PROPERTY>fast = alcoholism[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>heart_attacks</NAME>
	<PROPERTY>description = An acute medical emergency that occurs when blood flow to a part of the heart muscle is severely reduced or blocked, causing damage to heart tissue.</PROPERTY>
	<PROPERTY>fast = heart_attacks[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>cardiovascular_disease</NAME>
	<PROPERTY>description = A broad category encompassing conditions that affect the heart and blood vessels, impacting their structure and function.</PROPERTY>
	<PROPERTY>fast = cardiovascular_disease[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>seizure</NAME>
	<PROPERTY>description = A sudden, uncontrolled electrical disturbance in the brain, which can lead to temporary changes in behavior, movement, feelings, or states of consciousness.</PROPERTY>
	<PROPERTY>fast = seizure[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>blockages</NAME>
	<PROPERTY>description = Obstructions or impediments that can occur within various bodily passages, such as blood vessels, airways, or other ducts, hindering normal flow or function.</PROPERTY>
	<PROPERTY>fast = blockages[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>radiotherapy</NAME>
	<PROPERTY>description = A medical treatment method that utilizes high-energy radiation to target and damage specific types of cells within the body, often used in cancer treatment.</PROPERTY>
	<PROPERTY>fast = radiotherapy[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>premature_birth</NAME>
	<PROPERTY>description = The event of an infant being born before the completion of the full gestational period, typically before 37 weeks of pregnancy.</PROPERTY>
	<PROPERTY>fast = premature_birth[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>reduced_blood_flow</NAME>
	<PROPERTY>description = A physiological state characterized by a diminished volume of blood circulating through the body's vessels or specific organs.</PROPERTY>
	<PROPERTY>fast = reduced_blood_flow[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

