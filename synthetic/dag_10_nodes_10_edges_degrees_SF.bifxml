<?xml version="1.0" ?>

<BIF VERSION="0.3">
<NETWORK>
<NAME>dag_10_nodes_10_edges_degrees_SF</NAME>
<PROPERTY>software aGrUM</PROPERTY>

<!-- Variables -->
<VARIABLE TYPE="nature">
	<NAME>hormonal_changes</NAME>
	<PROPERTY>description = Alterations or imbalances in the body's endocrine system, affecting the concentration of various hormones.</PROPERTY>
	<PROPERTY>fast = hormonal_changes[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>migraines</NAME>
	<PROPERTY>description = A type of recurrent headache characterized by severe throbbing pain or a pulsing sensation, often accompanied by other symptoms.</PROPERTY>
	<PROPERTY>fast = migraines[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>vomiting</NAME>
	<PROPERTY>description = The forceful expulsion of the contents of the stomach through the mouth.</PROPERTY>
	<PROPERTY>fast = vomiting[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>lightheadedness</NAME>
	<PROPERTY>description = A sensation of faintness, dizziness, or giddiness, often indicating a reduction in blood flow to the brain.</PROPERTY>
	<PROPERTY>fast = lightheadedness[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>hypoxia</NAME>
	<PROPERTY>description = A condition in which the body or a region of the body is deprived of adequate oxygen supply at the tissue level.</PROPERTY>
	<PROPERTY>fast = hypoxia[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>low_blood_pressure</NAME>
	<PROPERTY>description = A physiological state where the force of blood against artery walls is consistently lower than optimal.</PROPERTY>
	<PROPERTY>fast = low_blood_pressure[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>low_levels</NAME>
	<PROPERTY>description = A measured decrease below the normal physiological range for a crucial bodily substance or parameter.</PROPERTY>
	<PROPERTY>fast = low_levels[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>hypotension</NAME>
	<PROPERTY>description = A medical state defined by abnormally low systemic blood pressure readings.</PROPERTY>
	<PROPERTY>fast = hypotension[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>severe_vertigo</NAME>
	<PROPERTY>description = An intense and debilitating sensation of spinning or dizziness, often accompanied by loss of balance.</PROPERTY>
	<PROPERTY>fast = severe_vertigo[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>cardiac_tamponade</NAME>
	<PROPERTY>description = A critical medical condition characterized by the accumulation of fluid around the heart, impeding its function.</PROPERTY>
	<PROPERTY>fast = cardiac_tamponade[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

