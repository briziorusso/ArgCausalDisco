<PROPERTY>software aGrUM</PROPERTY>

<!-- Variables -->
<VARIABLE TYPE="nature">
	<NAME>high_blood_pressure</NAME>
	<PROPERTY>description = A physiological state where the force of blood against the artery walls is consistently too high, a key indicator during routine health check-ups.</PROPERTY>
	<PROPERTY>fast = high_blood_pressure[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>angina</NAME>
	<PROPERTY>description = A symptom characterized by discomfort or pain in the chest, often described as pressure, squeezing, or fullness, which may occur in various health contexts.</PROPERTY>
	<PROPERTY>fast = angina[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>coronary_heart_disease</NAME>
	<PROPERTY>description = A chronic medical condition affecting the blood vessels that supply the heart muscle, potentially impacting its ability to function optimally over time.</PROPERTY>
	<PROPERTY>fast = coronary_heart_disease[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>numbness</NAME>
	<PROPERTY>description = A physical sensation characterized by a partial or complete loss of feeling in a particular body part, sometimes accompanied by a tingling sensation.</PROPERTY>
	<PROPERTY>fast = numbness[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>high_cholesterol</NAME>
	<PROPERTY>description = A medical condition characterized by elevated levels of cholesterol in an individual's bloodstream, often measured through routine blood tests.</PROPERTY>
	<PROPERTY>fast = high_cholesterol[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

