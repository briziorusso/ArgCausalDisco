<?xml version="1.0" ?>

<BIF VERSION="0.3">
<NETWORK>
<NAME>dag_10_nodes_15_edges_semantics_SF</NAME>
<PROPERTY>software aGrUM</PROPERTY>

<!-- Variables -->
<VARIABLE TYPE="nature">
	<NAME>drought</NAME>
	<PROPERTY>description = An extended period of unusually low precipitation, resulting in a shortage of water for ecological, agricultural, and human needs.</PROPERTY>
	<PROPERTY>fast = drought[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>forest_fires</NAME>
	<PROPERTY>description = Uncontrolled and often destructive combustion that consumes wildland vegetation, including forests, grasslands, and bush areas.</PROPERTY>
	<PROPERTY>fast = forest_fires[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>habitat_loss</NAME>
	<PROPERTY>description = The destruction or severe degradation of natural environments, leading to a reduction in the space and resources available for plant and animal species to survive.</PROPERTY>
	<PROPERTY>fast = habitat_loss[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>lightning</NAME>
	<PROPERTY>description = A sudden, powerful discharge of static electricity in the atmosphere, typically occurring during thunderstorms.</PROPERTY>
	<PROPERTY>fast = lightning[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>rain</NAME>
	<PROPERTY>description = Water droplets condensed from atmospheric water vapor that fall to the Earth's surface as precipitation.</PROPERTY>
	<PROPERTY>fast = rain[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>erosion</NAME>
	<PROPERTY>description = The process by which soil, rock, and other surficial material are removed and transported by natural agents such as wind, water, or ice.</PROPERTY>
	<PROPERTY>fast = erosion[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>rising_temperatures</NAME>
	<PROPERTY>description = A long-term trend of increasing average atmospheric and oceanic temperatures across a region or globally, often associated with climatic shifts.</PROPERTY>
	<PROPERTY>fast = rising_temperatures[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>urbanization</NAME>
	<PROPERTY>description = The demographic shift from rural to urban areas, leading to an increase in population density and the expansion of human settlements and infrastructure.</PROPERTY>
	<PROPERTY>fast = urbanization[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>changes_in_land_use</NAME>
	<PROPERTY>description = Modifications to the natural or managed environment by human activities, such as conversion of natural landscapes to agricultural fields, residential areas, or industrial zones.</PROPERTY>
	<PROPERTY>fast = changes_in_land_use[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>el_niño</NAME>
	<PROPERTY>description = A recurring oceanic-atmospheric climate pattern characterized by unusual warming of surface waters in the equatorial Pacific Ocean, influencing global weather systems.</PROPERTY>
	<PROPERTY>fast = el_niño[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

