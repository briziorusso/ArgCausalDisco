<?xml version="1.0" ?>

<BIF VERSION="0.3">
<NETWORK>
<NAME>dag_10_nodes_10_edges_none_ER</NAME>
<PROPERTY>software aGrUM</PROPERTY>

<!-- Variables -->
<VARIABLE TYPE="nature">
	<NAME>high_blood_pressure</NAME>
	<PROPERTY>description = Refers to a physiological state where the force of blood against artery walls is consistently elevated.</PROPERTY>
	<PROPERTY>fast = high_blood_pressure[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>chronic_disease</NAME>
	<PROPERTY>description = Identifies a long-lasting health condition that typically cannot be cured but can be controlled over an extended period.</PROPERTY>
	<PROPERTY>fast = chronic_disease[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>medical_problems</NAME>
	<PROPERTY>description = Denotes a general classification for various health issues, ailments, or disorders that an individual might experience.</PROPERTY>
	<PROPERTY>fast = medical_problems[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>numbness</NAME>
	<PROPERTY>description = Characterizes a loss of sensation, or a feeling of tingling or 'pins and needles,' in a specific part of the body.</PROPERTY>
	<PROPERTY>fast = numbness[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>serious_health_problems</NAME>
	<PROPERTY>description = Represents significant and potentially life-altering health conditions that require considerable medical attention or management.</PROPERTY>
	<PROPERTY>fast = serious_health_problems[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>nerve_damage</NAME>
	<PROPERTY>description = Pertains to an injury or impairment affecting the nerves, which are responsible for transmitting signals throughout the body.</PROPERTY>
	<PROPERTY>fast = nerve_damage[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>infertility</NAME>
	<PROPERTY>description = Describes the inability to conceive or produce offspring despite regular unprotected sexual intercourse over a defined period.</PROPERTY>
	<PROPERTY>fast = infertility[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>panic_attack</NAME>
	<PROPERTY>description = Describes an abrupt surge of intense fear or discomfort, often accompanied by physical symptoms like heart palpitations, shortness of breath, or dizziness.</PROPERTY>
	<PROPERTY>fast = panic_attack[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

