<?xml version="1.0" ?>

<BIF VERSION="0.3">
<NETWORK>
<NAME>dag_5_nodes_5_edges_semantics_random</NAME>
<PROPERTY>software aGrUM</PROPERTY>

<!-- Variables -->
<VARIABLE TYPE="nature">
	<NAME>brain_damage</NAME>
	<PROPERTY>description = An observable neurological condition characterized by structural or functional impairment of brain tissue, potentially impacting various cognitive and behavioral processes.</PROPERTY>
	<PROPERTY>fast = brain_damage[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>hallucinations</NAME>
	<PROPERTY>description = The occurrence of sensory perceptions (e.g., visual, auditory, tactile) experienced as real by an individual in the absence of corresponding external stimuli.</PROPERTY>
	<PROPERTY>fast = hallucinations[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>violent_behavior</NAME>
	<PROPERTY>description = The frequency, intensity, or likelihood of actions intended to cause physical harm, injury, or destruction to individuals, animals, or property.</PROPERTY>
	<PROPERTY>fast = violent_behavior[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>paranoia</NAME>
	<PROPERTY>description = A psychological state marked by persistent distrust and suspicion of others, often accompanied by delusions of persecution, conspiracy, or an exaggerated sense of threat.</PROPERTY>
	<PROPERTY>fast = paranoia[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>violent_video_games</NAME>
	<PROPERTY>description = A quantitative measure reflecting an individual's habitual exposure to or engagement with interactive digital entertainment content featuring overtly aggressive or combative themes.</PROPERTY>
	<PROPERTY>fast = violent_video_games[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

