<?xml version="1.0" ?>

<BIF VERSION="0.3">
<NETWORK>
<NAME>dag_10_nodes_10_edges_semantics_ER</NAME>
<PROPERTY>software aGrUM</PROPERTY>

<!-- Variables -->
<VARIABLE TYPE="nature">
	<NAME>chronic_pain</NAME>
	<PROPERTY>description = The self-reported or clinically assessed experience of persistent physical discomfort lasting for an extended duration among individuals in the population.</PROPERTY>
	<PROPERTY>fast = chronic_pain[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>despair</NAME>
	<PROPERTY>description = The profound feeling of hopelessness and extreme pessimism experienced by individuals within the community.</PROPERTY>
	<PROPERTY>fast = despair[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>irritability</NAME>
	<PROPERTY>description = The observed or self-reported tendency among individuals to become easily annoyed, agitated, or provoked.</PROPERTY>
	<PROPERTY>fast = irritability[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>loss_of_appetite</NAME>
	<PROPERTY>description = The measured or reported decrease in an individual's desire or capacity to eat.</PROPERTY>
	<PROPERTY>fast = loss_of_appetite[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>attacks</NAME>
	<PROPERTY>description = The recorded frequency of incidents involving physical or verbal aggression, or acts of vandalism, against individuals or groups within the community.</PROPERTY>
	<PROPERTY>fast = attacks[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>unrest</NAME>
	<PROPERTY>description = The level of visible disturbance, agitation, or discontent within a community or a segment of its population.</PROPERTY>
	<PROPERTY>fast = unrest[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>hatred</NAME>
	<PROPERTY>description = The intensity and widespread nature of intense animosity or antagonism directed at particular groups or individuals within the community.</PROPERTY>
	<PROPERTY>fast = hatred[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>instability</NAME>
	<PROPERTY>description = The degree to which a system, community, or situation is susceptible to sudden, disruptive changes or is lacking firm foundations.</PROPERTY>
	<PROPERTY>fast = instability[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>homophobia</NAME>
	<PROPERTY>description = The prevalence of negative attitudes and discriminatory behaviors directed towards individuals based on their sexual orientation within a specific population.</PROPERTY>
	<PROPERTY>fast = homophobia[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>mood_swings</NAME>
	<PROPERTY>description = The occurrence of noticeable and often rapid fluctuations in an individual's emotional state, ranging from highs to lows.</PROPERTY>
	<PROPERTY>fast = mood_swings[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

