<?xml version="1.0" ?>

<BIF VERSION="0.3">
<NETWORK>
<NAME>dag_5_nodes_5_edges_degrees_ER</NAME>
<PROPERTY>software aGrUM</PROPERTY>

<!-- Variables -->
<VARIABLE TYPE="nature">
	<NAME>chronic_pain</NAME>
	<PROPERTY>description = A persistent and often debilitating physical sensation of discomfort or ache, lasting for an extended period.</PROPERTY>
	<PROPERTY>fast = chronic_pain[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>degradation_of_neurons</NAME>
	<PROPERTY>description = The progressive deterioration or damage to nerve cells within the central or peripheral nervous system.</PROPERTY>
	<PROPERTY>fast = degradation_of_neurons[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>psychological_stress</NAME>
	<PROPERTY>description = A state of mental or emotional strain or tension resulting from adverse or demanding circumstances.</PROPERTY>
	<PROPERTY>fast = psychological_stress[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>sleep_problems</NAME>
	<PROPERTY>description = Any disturbance in the normal pattern or quality of sleep, potentially including difficulty initiating or maintaining sleep, or experiencing non-restorative sleep.</PROPERTY>
	<PROPERTY>fast = sleep_problems[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>chronic_fatigue_syndrome</NAME>
	<PROPERTY>description = A complex and severe medical condition characterized by persistent, debilitating exhaustion that does not improve with rest and may be worsened by physical or mental exertion.</PROPERTY>
	<PROPERTY>fast = chronic_fatigue_syndrome[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

