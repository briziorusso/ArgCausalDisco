<?xml version="1.0" ?>

<BIF VERSION="0.3">
<NETWORK>
<NAME>dag_5_nodes_7_edges_semantics_SF</NAME>
<PROPERTY>software aGrUM</PROPERTY>

<!-- Variables -->
<VARIABLE TYPE="nature">
	<NAME>high_blood_pressure</NAME>
	<PROPERTY>description = A clinical finding characterized by persistently elevated force exerted by circulating blood on the walls of the arteries.</PROPERTY>
	<PROPERTY>fast = high_blood_pressure[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>numbness</NAME>
	<PROPERTY>description = A sensory alteration described as a partial or complete loss of feeling or sensation in a specific body part, often accompanied by tingling or a "pins and needles" sensation.</PROPERTY>
	<PROPERTY>fast = numbness[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>insulin_resistance</NAME>
	<PROPERTY>description = A metabolic state where the body's cells exhibit reduced responsiveness to the hormone insulin, affecting glucose uptake and utilization.</PROPERTY>
	<PROPERTY>fast = insulin_resistance[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>neck_pain</NAME>
	<PROPERTY>description = A common physical sensation involving discomfort, aching, or stiffness localized to the cervical spine or surrounding soft tissues.</PROPERTY>
	<PROPERTY>fast = neck_pain[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>head_and_neck_cancer</NAME>
	<PROPERTY>description = A specific medical diagnosis indicating the presence of malignant cellular growth originating in the head or neck region.</PROPERTY>
	<PROPERTY>fast = head_and_neck_cancer[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

