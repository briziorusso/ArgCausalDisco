<!-- Variables -->
<VARIABLE TYPE="nature">
	<NAME>chronic_pain</NAME>
	<PROPERTY>description = Persistent physical discomfort or agony that endures over a prolonged period, often affecting daily activities and quality of life.</PROPERTY>
	<PROPERTY>fast = chronic_pain[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>irritability</NAME>
	<PROPERTY>description = A heightened state of emotional sensitivity, characterized by increased proneness to annoyance, frustration, or agitation.</PROPERTY>
	<PROPERTY>fast = irritability[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>dysfunction</NAME>
	<PROPERTY>description = An impairment in the normal operation or activity of a specific organ, system, or biological process.</PROPERTY>
	<PROPERTY>fast = dysfunction[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>tumors</NAME>
	<PROPERTY>description = The presence of abnormal cellular growths, which can manifest in various forms and locations within an organism.</PROPERTY>
	<PROPERTY>fast = tumors[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>sleep_apnea</NAME>
	<PROPERTY>description = A diagnosed medical condition characterized by recurrent interruptions in breathing during sleep, impacting restorative rest.</PROPERTY>
	<PROPERTY>fast = sleep_apnea[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

