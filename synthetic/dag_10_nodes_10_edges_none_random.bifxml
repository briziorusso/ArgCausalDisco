<?xml version="1.0" ?>

<BIF VERSION="0.3">
<NETWORK>
<NAME>dag_10_nodes_10_edges_none_random</NAME>
<PROPERTY>software aGrUM</PROPERTY>

<!-- Variables -->
<VARIABLE TYPE="nature">
	<NAME>asbestos_exposure</NAME>
	<PROPERTY>description = The extent to which individuals have encountered or inhaled microscopic asbestos fibers from their surroundings.</PROPERTY>
	<PROPERTY>fast = asbestos_exposure[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>serious_health_conditions</NAME>
	<PROPERTY>description = Life-threatening, severely debilitating, or chronic medical ailments requiring significant medical intervention or care.</PROPERTY>
	<PROPERTY>fast = serious_health_conditions[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>high_blood_pressure</NAME>
	<PROPERTY>description = A medical state characterized by persistently elevated arterial blood pressure.</PROPERTY>
	<PROPERTY>fast = high_blood_pressure[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
