	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>alcoholism</NAME>
	<PROPERTY>description = A chronic disease marked by an impaired ability to control alcohol consumption, despite negative consequences.</PROPERTY>
	<PROPERTY>fast = alcoholism[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
