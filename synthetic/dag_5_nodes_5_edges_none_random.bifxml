<?xml version="1.0" ?>

<BIF VERSION="0.3">
<NETWORK>
<NAME>dag_5_nodes_5_edges_none_random</NAME>
<PROPERTY>software aGrUM</PROPERTY>

<!-- Variables -->
<VARIABLE TYPE="nature">
	<NAME>misconduct</NAME>
	<PROPERTY>description = Actions or behaviors that violate established rules, policies, ethical standards, or expected professional conduct within an organizational setting.</PROPERTY>
	<PROPERTY>fast = misconduct[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>prejudice</NAME>
	<PROPERTY>description = The formation of preconceived negative opinions, judgments, or attitudes towards individuals or groups, often lacking a rational basis or sufficient direct experience.</PROPERTY>
	<PROPERTY>fast = prejudice[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>substance_abuse</NAME>
	<PROPERTY>description = The habitual or excessive use of psychoactive substances, such as alcohol or drugs, which can affect an individual's daily life and responsibilities.</PROPERTY>
	<PROPERTY>fast = substance_abuse[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>impairment</NAME>
	<PROPERTY>description = A significant reduction in an individual's physical, cognitive, or emotional capacity, affecting their ability to perform tasks or function effectively.</PROPERTY>
	<PROPERTY>fast = impairment[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>discrimination</NAME>
	<PROPERTY>description = The unfair or differential treatment of individuals or groups based on perceived characteristics or unfounded beliefs, leading to disadvantages or unequal opportunities.</PROPERTY>
	<PROPERTY>fast = discrimination[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

