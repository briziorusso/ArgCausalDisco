<?xml version="1.0" ?>

<BIF VERSION="0.3">
<NETWORK>
<NAME>dag_5_nodes_5_edges_none_SF</NAME>
<PROPERTY>software aGrUM</PROPERTY>

<!-- Variables -->
<VARIABLE TYPE="nature">
	<NAME>loss_of_appetite</NAME>
	<PROPERTY>description = A subjective reduction in the desire or willingness to eat, leading to decreased food intake.</PROPERTY>
	<PROPERTY>fast = loss_of_appetite[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>anorexia</NAME>
	<PROPERTY>description = A medical state characterized by a significant and often persistent aversion to food or severely restricted food intake, leading to nutritional deficiencies and potential health complications.</PROPERTY>
	<PROPERTY>fast = anorexia[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>vomiting</NAME>
	<PROPERTY>description = The act of involuntarily expelling stomach contents through the mouth.</PROPERTY>
	<PROPERTY>fast = vomiting[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>migraines</NAME>
	<PROPERTY>description = The occurrence of severe headaches, frequently accompanied by pulsating pain, nausea, or sensitivity to light and sound.</PROPERTY>
	<PROPERTY>fast = migraines[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>abdominal_pain</NAME>
	<PROPERTY>description = The presence of discomfort or pain within the abdominal region, varying in intensity and location.</PROPERTY>
	<PROPERTY>fast = abdominal_pain[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

