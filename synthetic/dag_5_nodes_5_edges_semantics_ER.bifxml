<?xml version="1.0" ?>

<BIF VERSION="0.3">
<NETWORK>
<NAME>dag_5_nodes_5_edges_semantics_ER</NAME>
<PROPERTY>software aGrUM</PROPERTY>

<!-- Variables -->
<VARIABLE TYPE="nature">
	<NAME>chronic_pain</NAME>
	<PROPERTY>description = The persistent and long-term physical discomfort or suffering experienced by the individual, significantly affecting their daily life and overall well-being.</PROPERTY>
	<PROPERTY>fast = chronic_pain[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>low_self-esteem</NAME>
	<PROPERTY>description = A persistent feeling of inadequacy, self-doubt, or a diminished sense of personal worth experienced by the individual, influencing their perception of themselves.</PROPERTY>
	<PROPERTY>fast = low_self-esteem[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>social_problems</NAME>
	<PROPERTY>description = The range of difficulties and negative interactions the individual encounters within their community, personal relationships, or broader societal contexts, leading to adverse outcomes.</PROPERTY>
	<PROPERTY>fast = social_problems[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>gambling</NAME>
	<PROPERTY>description = The individual's participation in games of chance, often involving financial risk, as a regular activity or habit within their life.</PROPERTY>
	<PROPERTY>fast = gambling[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>bribes</NAME>
	<PROPERTY>description = Instances where the individual is involved in offering, accepting, or facilitating illicit payments or favors to influence decisions or outcomes in their professional or personal dealings.</PROPERTY>
	<PROPERTY>fast = bribes[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

