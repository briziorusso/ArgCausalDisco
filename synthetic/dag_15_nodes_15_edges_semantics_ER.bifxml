	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>overeating</NAME>
	<PROPERTY>description = The act of consuming food in quantities beyond typical hunger, often leading to feelings of fullness or discomfort.</PROPERTY>
	<PROPERTY>fast = overeating[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>excess_weight</NAME>
