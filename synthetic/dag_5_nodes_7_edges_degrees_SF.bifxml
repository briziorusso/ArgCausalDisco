<?xml version="1.0" ?>

<BIF VERSION="0.3">
<NETWORK>
<NAME>dag_5_nodes_7_edges_degrees_SF</NAME>
<PROPERTY>software aGrUM</PROPERTY>

<!-- Variables -->
<VARIABLE TYPE="nature">
	<NAME>high_blood_pressure</NAME>
	<PROPERTY>description = This variable measures the systemic arterial pressure, specifically noting instances where it consistently exceeds healthy limits.</PROPERTY>
	<PROPERTY>fast = high_blood_pressure[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>eye_problems</NAME>
	<PROPERTY>description = This variable represents the occurrence of various medical conditions or symptoms affecting the ocular system, which can range from minor irritations to significant visual impairments.</PROPERTY>
	<PROPERTY>fast = eye_problems[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>rosacea</NAME>
	<PROPERTY>description = This variable characterizes the manifestation of a chronic inflammatory skin disorder, primarily recognized by facial redness, visible blood vessels, and sometimes papules or pustules.</PROPERTY>
	<PROPERTY>fast = rosacea[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>ulcers</NAME>
	<PROPERTY>description = This variable indicates the presence and severity of localized breaks or open sores that develop on the surface of internal or external bodily tissues.</PROPERTY>
	<PROPERTY>fast = ulcers[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>damage_to_the_intestinal_lining</NAME>
	<PROPERTY>description = This variable quantifies the extent of compromised structural integrity or injury observed in the protective lining of the gastrointestinal tract.</PROPERTY>
	<PROPERTY>fast = damage_to_the_intestinal_lining[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<!-- Probability distributions -->
<DEFINITION>
	<FOR>high_blood_pressure</FOR>
	<GIVEN>ulcers</GIVEN>
	<TABLE>
		0.754342 0.245658
		0.18574 0.81426
	</TABLE>
</DEFINITION>
<DEFINITION>
	<FOR>eye_problems</FOR>
	<GIVEN>rosacea</GIVEN>
	<GIVEN>high_blood_pressure</GIVEN>
	<TABLE>
		0.498711 0.501289
		0.368676 0.631324
		0.230579 0.769421
		0.17032 0.82968
	</TABLE>
</DEFINITION>
<DEFINITION>
	<FOR>rosacea</FOR>
	<TABLE>
		0.537218 0.462782
	</TABLE>
</DEFINITION>
<DEFINITION>
	<FOR>ulcers</FOR>
	<GIVEN>damage_to_the_intestinal_lining</GIVEN>
	<TABLE>
		0.723516 0.276484
		0.732356 0.267644
	</TABLE>
</DEFINITION>
<DEFINITION>
	<FOR>damage_to_the_intestinal_lining</FOR>
	<TABLE>
		0.00298284 0.997017
	</TABLE>
</DEFINITION>

</NETWORK>
</BIF>
