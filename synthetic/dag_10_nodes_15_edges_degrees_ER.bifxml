<PROPERTY>software aGrUM</PROPERTY>

<!-- Variables -->
<VARIABLE TYPE="nature">
	<NAME>high_blood_pressure</NAME>
	<PROPERTY>description = A chronic medical condition characterized by persistently elevated arterial blood pressure, often requiring long-term management.</PROPERTY>
	<PROPERTY>fast = high_blood_pressure[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>chronic_disease</NAME>
	<PROPERTY>description = A long-lasting health condition, typically non-communicable, that progresses slowly and often requires ongoing medical attention.</PROPERTY>
	<PROPERTY>fast = chronic_disease[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>heart_problems</NAME>
	<PROPERTY>description = A broad category encompassing various health conditions affecting the structure, function, and overall health of the heart.</PROPERTY>
	<PROPERTY>fast = heart_problems[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>sexual_dysfunction</NAME>
	<PROPERTY>description = Persistent difficulties experienced by an individual in experiencing satisfaction from sexual activity due to problems with desire, arousal, orgasm, or pain.</PROPERTY>
	<PROPERTY>fast = sexual_dysfunction[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
