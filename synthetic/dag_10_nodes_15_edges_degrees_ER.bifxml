	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>sudden_death</NAME>
	<PROPERTY>description = The unexpected and rapid cessation of all vital bodily functions, occurring shortly after the onset of symptoms or without any warning.</PROPERTY>
	<PROPERTY>fast = sudden_death[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>hypothyroidism</NAME>
	<PROPERTY>description = An endocrine disorder where the thyroid gland produces an insufficient amount of crucial hormones necessary for regulating metabolism.</PROPERTY>
	<PROPERTY>fast = hypothyroidism[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>nerve_damage</NAME>
	<PROPERTY>description = Any injury or dysfunction affecting the nerves, which can impair their ability to transmit signals and lead to various sensory, motor, or autonomic deficits.</PROPERTY>
	<PROPERTY>fast = nerve_damage[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>syndrome</NAME>
	<PROPERTY>description = A specific collection of signs and symptoms that characteristically occur together, indicative of a particular disease or disorder.</PROPERTY>
	<PROPERTY>fast = syndrome[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>blood_pressure</NAME>
	<PROPERTY>description = The physiological state related to the force exerted by circulating blood against the walls of the body's arteries, a key vital sign.</PROPERTY>
	<PROPERTY>fast = blood_pressure[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>prostate_gland_cancer_surgery</NAME>
	<PROPERTY>description = A major surgical intervention involving the removal of all or part of the prostate gland, typically performed to treat prostate cancer.</PROPERTY>
	<PROPERTY>fast = prostate_gland_cancer_surgery[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

