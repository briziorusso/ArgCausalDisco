<?xml version="1.0" ?>

<BIF VERSION="0.3">
<NETWORK>
<NAME>dag_15_nodes_22_edges_degrees_SF</NAME>
<PROPERTY>software aGrUM</PROPERTY>

<!-- Variables -->
<VARIABLE TYPE="nature">
	<NAME>high_blood_pressure</NAME>
	<PROPERTY>description = A medical condition, also known as hypertension, where the force of blood pushing against the artery walls is consistently elevated.</PROPERTY>
	<PROPERTY>fast = high_blood_pressure[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>coronary_heart_disease</NAME>
	<PROPERTY>description = A significant medical condition involving damage or disease in the major blood vessels that supply blood to the heart muscle.</PROPERTY>
	<PROPERTY>fast = coronary_heart_disease[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>lack_of_sleep</NAME>
	<PROPERTY>description = A state characterized by an insufficient quantity or poor quality of sleep, potentially affecting overall health and bodily functions.</PROPERTY>
	<PROPERTY>fast = lack_of_sleep[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>insulin_resistance</NAME>
	<PROPERTY>description = A physiological state in which the body's cells become less responsive to insulin, a hormone critical for regulating blood sugar.</PROPERTY>
	<PROPERTY>fast = insulin_resistance[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>acid_reflux</NAME>
	<PROPERTY>description = A specific type of reflux involving the backflow of stomach acid into the esophagus, potentially causing irritation and discomfort.</PROPERTY>
	<PROPERTY>fast = acid_reflux[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>heartburn</NAME>
	<PROPERTY>description = A common symptom described as a burning sensation in the chest, typically located behind the breastbone, often associated with digestive issues.</PROPERTY>
	<PROPERTY>fast = heartburn[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>reflux</NAME>
	<PROPERTY>description = The backward flow of fluids or contents from one body cavity into another, often referring to gastric contents moving up the esophagus.</PROPERTY>
	<PROPERTY>fast = reflux[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>ulcerative_colitis</NAME>
	<PROPERTY>description = A chronic inflammatory bowel disease specifically affecting the lining of the large intestine and rectum, leading to inflammation and sores.</PROPERTY>
	<PROPERTY>fast = ulcerative_colitis[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>ulcers</NAME>
	<PROPERTY>description = Open sores or lesions that develop on the lining of various internal body surfaces, such as the digestive tract, causing pain and potential complications.</PROPERTY>
	<PROPERTY>fast = ulcers[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>olanzapine</NAME>
	<PROPERTY>description = A specific pharmaceutical compound categorized as an atypical antipsychotic medication, prescribed for certain mental health conditions.</PROPERTY>
	<PROPERTY>fast = olanzapine[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>hyperlipidemia</NAME>
	<PROPERTY>description = A medical condition defined by abnormally high levels of lipids (fats), including cholesterol and triglycerides, circulating in the blood.</PROPERTY>
	<PROPERTY>fast = hyperlipidemia[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>high_salt_consumption</NAME>
	<PROPERTY>description = A dietary habit characterized by the regular intake of excessive amounts of sodium, commonly found in processed foods and added to meals.</PROPERTY>
	<PROPERTY>fast = high_salt_consumption[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>elevated_cholesterol</NAME>
	<PROPERTY>description = A medical state where the levels of cholesterol, a type of lipid, in the bloodstream are higher than healthy reference ranges.</PROPERTY>
	<PROPERTY>fast = elevated_cholesterol[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>colitis</NAME>
	<PROPERTY>description = An inflammatory condition affecting the colon, which is the large intestine, leading to various gastrointestinal symptoms.</PROPERTY>
	<PROPERTY>fast = colitis[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>narrowing_of_the_blood_vessels</NAME>
	<PROPERTY>description = A physiological condition characterized by a reduction in the internal diameter of blood vessels, often impacting blood flow to various organs.</PROPERTY>
	<PROPERTY>fast = narrowing_of_the_blood_vessels[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

