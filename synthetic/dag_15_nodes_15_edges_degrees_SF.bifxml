<?xml version="1.0" ?>

<BIF VERSION="0.3">
<NETWORK>
<NAME>dag_15_nodes_15_edges_degrees_SF</NAME>
<PROPERTY>software aGrUM</PROPERTY>

<!-- Variables -->
<VARIABLE TYPE="nature">
	<NAME>alcoholism</NAME>
	<PROPERTY>description = A chronic disease characterized by an impaired ability to control alcohol intake, preoccupation with alcohol, and continued use despite adverse consequences.</PROPERTY>
	<PROPERTY>fast = alcoholism[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>brain_damage</NAME>
	<PROPERTY>description = Any injury or insult to the brain that results in the impairment of its normal function.</PROPERTY>
	<PROPERTY>fast = brain_damage[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>heart_attacks</NAME>
	<PROPERTY>description = An acute medical event resulting from a sudden blockage of blood flow to the heart muscle.</PROPERTY>
	<PROPERTY>fast = heart_attacks[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
