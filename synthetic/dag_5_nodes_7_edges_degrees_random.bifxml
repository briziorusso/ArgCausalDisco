<?xml version="1.0" ?>

<BIF VERSION="0.3">
<NETWORK>
<NAME>dag_5_nodes_7_edges_degrees_random</NAME>
<PROPERTY>software aGrUM</PROPERTY>

<!-- Variables -->
<VARIABLE TYPE="nature">
	<NAME>stomach_cancer</NAME>
	<PROPERTY>description = The uncontrolled proliferation of abnormal cells within the tissues of the stomach, representing a malignant disease state.</PROPERTY>
	<PROPERTY>fast = stomach_cancer[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>indigestion</NAME>
	<PROPERTY>description = A condition characterized by impaired digestion, often accompanied by symptoms such as discomfort, bloating, or nausea in the upper abdomen.</PROPERTY>
	<PROPERTY>fast = indigestion[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>ulcers</NAME>
	<PROPERTY>description = Eroded lesions that form on the inner lining of the stomach or the initial part of the small intestine.</PROPERTY>
	<PROPERTY>fast = ulcers[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>abdominal_pain</NAME>
	<PROPERTY>description = A general experience of discomfort, aching, or soreness originating within the abdominal region.</PROPERTY>
	<PROPERTY>fast = abdominal_pain[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>stomach_infection</NAME>
	<PROPERTY>description = The presence of pathogenic microorganisms within the gastric system, potentially leading to various physiological responses.</PROPERTY>
	<PROPERTY>fast = stomach_infection[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

