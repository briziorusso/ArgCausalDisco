<?xml version="1.0" ?>

<BIF VERSION="0.3">
<NETWORK>
<NAME>dag_10_nodes_15_edges_none_SF</NAME>
<PROPERTY>software aGrUM</PROPERTY>

<!-- Variables -->
<VARIABLE TYPE="nature">
	<NAME>high_blood_pressure</NAME>
	<PROPERTY>description = A chronic medical condition where the force of blood against the artery walls is consistently too high, requiring the heart to work harder to pump blood.</PROPERTY>
	<PROPERTY>fast = high_blood_pressure[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>cardiovascular_diseases</NAME>
	<PROPERTY>description = A broad category of diseases affecting the heart and blood vessels, encompassing various conditions such as coronary artery disease, heart failure, and stroke.</PROPERTY>
	<PROPERTY>fast = cardiovascular_diseases[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>premature_death</NAME>
	<PROPERTY>description = The occurrence of death at an age significantly younger than the average life expectancy within a given population.</PROPERTY>
	<PROPERTY>fast = premature_death[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>alcoholism</NAME>
	<PROPERTY>description = A chronic medical condition characterized by an impaired ability to control alcohol intake, leading to various health and social issues.</PROPERTY>
	<PROPERTY>fast = alcoholism[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>overweight</NAME>
	<PROPERTY>description = A classification of body weight indicating an excess accumulation of body fat that may impair health, often determined by a Body Mass Index (BMI) in a specific range.</PROPERTY>
	<PROPERTY>fast = overweight[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>oxidative_stress</NAME>
	<PROPERTY>description = An physiological state resulting from an imbalance between the production of reactive oxygen species and the body's antioxidant defenses, potentially impacting cellular function.</PROPERTY>
	<PROPERTY>fast = oxidative_stress[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>hormonal_imbalances</NAME>
	<PROPERTY>description = A condition where there is an atypical concentration of certain hormones in the body, potentially affecting various physiological processes.</PROPERTY>
	<PROPERTY>fast = hormonal_imbalances[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>chd</NAME>
	<PROPERTY>description = A specific type of heart condition characterized by the narrowing or blockage of the coronary arteries, which supply blood to the heart muscle.</PROPERTY>
	<PROPERTY>fast = chd[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>lifestyle</NAME>
	<PROPERTY>description = The general way of living of an individual, including daily habits, dietary choices, physical activity levels, and social behaviors.</PROPERTY>
	<PROPERTY>fast = lifestyle[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>metabolic_syndrome</NAME>
	<PROPERTY>description = A medical condition characterized by a combination of risk factors, including elevated blood pressure, high blood sugar, and abnormal cholesterol levels, affecting an individual's metabolic health.</PROPERTY>
	<PROPERTY>fast = metabolic_syndrome[2]</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0</OUTCOME>
	<OUTCOME>1</OUTCOME>
</VARIABLE>

