indep(X,Y,S) :- ext_indep(X,Y,S), var(X), var(Y), set(S), X!=Y.
dep(X,Y,S) :- ext_dep(X,Y,S), var(X), var(Y), set(S), X!=Y.
p1 :- edge(0,6),edge(6,5),edge(5,4),edge(4,3),edge(3,2),edge(2,1).
ap(0,1,p1,S) :- p1, nb(6,0,5,S),nb(5,6,4,S),nb(4,5,3,S),nb(3,4,2,S),nb(2,3,1,S), not in(0,S), not in(1,S), set(S).
p2 :- edge(0,6),edge(6,5),edge(5,4),edge(4,3),edge(3,1).
ap(0,1,p2,S) :- p2, nb(6,0,5,S),nb(5,6,4,S),nb(4,5,3,S),nb(3,4,1,S), not in(0,S), not in(1,S), set(S).
p3 :- edge(0,6),edge(6,5),edge(5,4),edge(4,2),edge(2,3),edge(3,1).
ap(0,1,p3,S) :- p3, nb(6,0,5,S),nb(5,6,4,S),nb(4,5,2,S),nb(2,4,3,S),nb(3,2,1,S), not in(0,S), not in(1,S), set(S).
p4 :- edge(0,6),edge(6,5),edge(5,4),edge(4,2),edge(2,1).
