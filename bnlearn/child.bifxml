<?xml version="1.0" ?>

<BIF VERSION="0.3">
<NETWORK>
<NAME>Neonatal Cardiorespiratory Assessment Graph</NAME>
<PROPERTY>software aGrUM</PROPERTY>

<!-- Variables -->
<VARIABLE TYPE="nature">
	<NAME>BirthAsphyxia</NAME>
	<PROPERTY>description = Whether the infant experienced a lack of oxygen during or immediately after birth.</PROPERTY>
	<PROPERTY>fast = BirthAsphyxia{yes|no}</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>yes</OUTCOME>
	<OUTCOME>no</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>HypDistrib</NAME>
	<PROPERTY>description = The pattern of oxygen saturation across different regions of the infant's body, indicating uniformity or disparity.</PROPERTY>
	<PROPERTY>fast = HypDistrib{Equal|Unequal}</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>Equal</OUTCOME>
	<OUTCOME>Unequal</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>HypoxiaInO2</NAME>
	<PROPERTY>description = The severity of systemic oxygen deprivation experienced by the infant, specifically when receiving supplemental oxygen.</PROPERTY>
	<PROPERTY>fast = HypoxiaInO2{Mild|Moderate|Severe}</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>Mild</OUTCOME>
	<OUTCOME>Moderate</OUTCOME>
	<OUTCOME>Severe</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>CO2</NAME>
	<PROPERTY>description = The measured concentration of carbon dioxide in the infant's blood.</PROPERTY>
	<PROPERTY>fast = CO2{Normal|Low|High}</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>Normal</OUTCOME>
	<OUTCOME>Low</OUTCOME>
	<OUTCOME>High</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>ChestXray</NAME>
	<PROPERTY>description = The visual findings observed in a radiographic image of the infant's chest.</PROPERTY>
	<PROPERTY>fast = ChestXray{Normal|Oligaemic|Plethoric|Grd_Glass|Asy_or_Patch}</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>Normal</OUTCOME>
	<OUTCOME>Oligaemic</OUTCOME>
	<OUTCOME>Plethoric</OUTCOME>
	<OUTCOME>Grd_Glass</OUTCOME>
	<OUTCOME>Asy_or_Patch</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>Grunting</NAME>
	<PROPERTY>description = A distinct audible respiratory effort made by the infant, often associated with breathing difficulties.</PROPERTY>
	<PROPERTY>fast = Grunting{yes|no}</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>yes</OUTCOME>
	<OUTCOME>no</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>LVHreport</NAME>
	<PROPERTY>description = The documented diagnostic conclusion regarding the presence or absence of left ventricular hypertrophy.</PROPERTY>
	<PROPERTY>fast = LVHreport{yes|no}</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>yes</OUTCOME>
	<OUTCOME>no</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>LowerBodyO2</NAME>
	<PROPERTY>description = The measured oxygen saturation level in the lower half of the infant's body, typically reflecting post-ductal oxygenation.</PROPERTY>
	<PROPERTY>fast = LowerBodyO2{lt_5|5_to_12|gt_12}</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>lt_5</OUTCOME>
	<OUTCOME>5_to_12</OUTCOME>
	<OUTCOME>gt_12</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>RUQO2</NAME>
	<PROPERTY>description = The measured oxygen saturation level in the upper right quadrant of the infant's body, typically reflecting pre-ductal oxygenation.</PROPERTY>
	<PROPERTY>fast = RUQO2{lt_5|5_to_12|gt_12}</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>lt_5</OUTCOME>
	<OUTCOME>5_to_12</OUTCOME>
	<OUTCOME>gt_12</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>CO2Report</NAME>
	<PROPERTY>description = The formal laboratory report detailing the infant's blood carbon dioxide levels.</PROPERTY>
	<PROPERTY>fast = CO2Report{lt_7.5|ge_7.5}</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>lt_7.5</OUTCOME>
	<OUTCOME>ge_7.5</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>XrayReport</NAME>
	<PROPERTY>description = The formal radiological interpretation and conclusion derived from a chest X-ray examination.</PROPERTY>
	<PROPERTY>fast = XrayReport{Normal|Oligaemic|Plethoric|Grd_Glass|Asy_or_Patchy}</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>Normal</OUTCOME>
	<OUTCOME>Oligaemic</OUTCOME>
	<OUTCOME>Plethoric</OUTCOME>
	<OUTCOME>Grd_Glass</OUTCOME>
	<OUTCOME>Asy_or_Patchy</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>Disease</NAME>
	<PROPERTY>description = The primary medical condition affecting the infant, which may include specific congenital cardiac anomalies or pulmonary conditions.</PROPERTY>
	<PROPERTY>fast = Disease{PFC|TGA|Fallot|PAIVS|TAPVD|Lung}</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>PFC</OUTCOME>
	<OUTCOME>TGA</OUTCOME>
	<OUTCOME>Fallot</OUTCOME>
	<OUTCOME>PAIVS</OUTCOME>
	<OUTCOME>TAPVD</OUTCOME>
	<OUTCOME>Lung</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>GruntingReport</NAME>
	<PROPERTY>description = The medical record indicating the presence or absence of grunting respirations observed in the infant.</PROPERTY>
	<PROPERTY>fast = GruntingReport{yes|no}</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>yes</OUTCOME>
	<OUTCOME>no</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>Age</NAME>
	<PROPERTY>description = The chronological age of the infant at the time of clinical evaluation, categorized into early postnatal periods.</PROPERTY>
	<PROPERTY>fast = Age{0_to_3_days|4_to_10_days|11_to_30_days}</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>0_to_3_days</OUTCOME>
	<OUTCOME>4_to_10_days</OUTCOME>
	<OUTCOME>11_to_30_days</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>LVH</NAME>
	<PROPERTY>description = An indication of an enlarged or thickened left ventricle of the heart.</PROPERTY>
	<PROPERTY>fast = LVH{yes|no}</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>yes</OUTCOME>
	<OUTCOME>no</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>DuctFlow</NAME>
	<PROPERTY>description = The direction and patency of blood flow through the ductus arteriosus, a transient fetal blood vessel.</PROPERTY>
	<PROPERTY>fast = DuctFlow{Lt_to_Rt|None|Rt_to_Lt}</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>Lt_to_Rt</OUTCOME>
	<OUTCOME>None</OUTCOME>
	<OUTCOME>Rt_to_Lt</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>CardiacMixing</NAME>
	<PROPERTY>description = The degree to which oxygenated and deoxygenated blood streams intermingle within the heart's circulation.</PROPERTY>
	<PROPERTY>fast = CardiacMixing{None|Mild|Complete|Transp.}</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>None</OUTCOME>
	<OUTCOME>Mild</OUTCOME>
	<OUTCOME>Complete</OUTCOME>
	<OUTCOME>Transp.</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>LungParench</NAME>
	<PROPERTY>description = The structural and functional state of the lung tissue, assessed for conditions like congestion or other abnormalities.</PROPERTY>
	<PROPERTY>fast = LungParench{Normal|Congested|Abnormal}</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>Normal</OUTCOME>
	<OUTCOME>Congested</OUTCOME>
	<OUTCOME>Abnormal</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>LungFlow</NAME>
	<PROPERTY>description = The rate and volume of blood circulation through the pulmonary vascular system.</PROPERTY>
	<PROPERTY>fast = LungFlow{Normal|Low|High}</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>Normal</OUTCOME>
	<OUTCOME>Low</OUTCOME>
	<OUTCOME>High</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>Sick</NAME>
	<PROPERTY>description = A general clinical assessment reflecting the infant's overall state of health and well-being, indicating the presence of illness.</PROPERTY>
	<PROPERTY>fast = Sick{yes|no}</PROPERTY>
<!- OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility->
	<OUTCOME>yes</OUTCOME>
	<OUTCOME>no</OUTCOME>
</VARIABLE>

